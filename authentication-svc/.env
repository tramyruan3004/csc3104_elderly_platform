# --- Database ---
DATABASE_URL=postgresql+psycopg_async://auth:authpwd@auth-db:5432/authentication

# --- Tokens (match docker-compose) ---
ACCESS_TOKEN_EXP_MINUTES=60
REFRESH_TOKEN_EXP_MINUTES=10080

# --- JWT key handling ---
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
AUTO_WRITE_KEYS=false

# --- Initial service client ---
SERVICE_CLIENT_ID=organiser-dashboard
SERVICE_CLIENT_SECRET=organiser-dashboard-secret
