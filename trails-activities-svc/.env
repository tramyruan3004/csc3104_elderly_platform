# Postgres (async driver)
DATABASE_URL=postgresql+psycopg_async://trails:trailspwd@trails-db:5432/trails
AUTH_JWKS_URL=http://authentication-svc:8001/auth/jwks

# token issuer 
TOKEN_ISSUER=authentication-svc

# Invitations
INVITE_SECRET=change-this-to-a-long-random-string
INVITE_TTL_HOURS=168        # 7 days default
INVITE_BASE_URL=http://localhost:8002/invites